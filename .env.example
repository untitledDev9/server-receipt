PORT=6499
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/receipt-platform
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
# Leave unset for local dev. In production, set to this API's own public
# URL (e.g. https://api.yourapp.com) so uploaded logo links resolve
# correctly from the separately-deployed client.
PUBLIC_SERVER_URL=
PLATFORM_NAME=Receipt
UPLOAD_DIR=uploads
