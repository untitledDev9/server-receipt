PORT=6499
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/receipt-platform
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173
PLATFORM_NAME=Receipt

# Credentials for the single super admin account, created by `npm run seed`.
# These are demo defaults — change ADMIN_PASSWORD before seeding a real
# deployment, since this is the only login for the entire platform.
ADMIN_EMAIL=admin@receipt.com
ADMIN_PASSWORD=Password@123
